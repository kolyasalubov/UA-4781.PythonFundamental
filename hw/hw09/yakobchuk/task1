from random import randint

secret_number = randint(1, 100)
attempts = 10

print("Guess the number from 1 to 100!")
print("You have 10 tries.")

for i in range(attempts):
    user_number = int(input(f"Attempt {i + 1}: Enter your number: "))

    if user_number == secret_number:
        print("Congratulations! You guessed the number!")
        break
    elif user_number < secret_number:
        print("The hidden number is greater.")
    else:
        print("The hidden number is less.")

else:
    print("You lost! You used all 10 attempts.")
    print(f"The hidden number was: {secret_number}")